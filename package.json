{
  "name": "csgo-web-lan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.standalone.ts --host 127.0.0.1 --port 27016",
    "build": "npm run build:standalone && npm run build:server",
    "start": "node scripts/lan-service.mjs start",
    "source:start": "node scripts/lan-service.mjs start source",
    "source:stop": "node scripts/lan-service.mjs stop source",
    "source:status": "node scripts/lan-service.mjs status source",
    "source:build": "node scripts/source-release.mjs stage",
    "lint": "oxlint",
    "format": "oxfmt",
    "server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:standalone": "vite build --config vite.standalone.ts",
    "dev:standalone": "vite --config vite.standalone.ts --host 127.0.0.1 --port 5192",
    "qa": "npm run typecheck && npm test && npm run build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:sites": "npm run build:standalone && node scripts/stage-site.mjs",
    "stop": "node scripts/lan-service.mjs stop",
    "status": "node scripts/lan-service.mjs status",
    "test:lan": "tsx scripts/csgo-lan-smoke.ts",
    "source:stage": "node scripts/source-release.mjs stage",
    "source:check": "node scripts/source-release.mjs check",
    "source:verify": "node scripts/source-release.mjs verify",
    "source:preflight": "node scripts/source-release.mjs preflight",
    "source:plan": "node scripts/source-release.mjs plan"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@colyseus/core": "^0.18.10",
